{
  "version": 1,
  "sdk_version": "2.0.2",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://huokjnlsnruyxozxsmrg.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ],
    "jwks_uri": "https://huokjnlsnruyxozxsmrg.supabase.co/auth/v1/.well-known/jwks.json"
  },
  "mcp": {
    "server": {
      "name": "cogni-for-students",
      "version": "1.0.0",
      "title": "Cogni For Students"
    },
    "tools": [
      {
        "name": "list_assignments",
        "title": "List assignments",
        "description": "List the signed-in student's assignments, newest due first. Optionally filter by status.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "status": {
              "description": "Filter by status. Defaults to all.",
              "type": "string",
              "enum": [
                "todo",
                "doing",
                "done",
                "all"
              ]
            },
            "limit": {
              "description": "Maximum rows to return (default 25).",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "create_assignment",
        "title": "Create assignment",
        "description": "Create a new assignment for the signed-in student.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "Assignment title."
            },
            "description": {
              "description": "Optional details.",
              "type": "string",
              "maxLength": 4000
            },
            "due": {
              "description": "Optional due date as an ISO 8601 timestamp.",
              "type": "string"
            },
            "priority": {
              "description": "Priority (default medium).",
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high"
              ]
            },
            "tags": {
              "description": "Optional subject tags.",
              "maxItems": 10,
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 40
              }
            }
          },
          "required": [
            "title"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "update_assignment_status",
        "title": "Update assignment status",
        "description": "Move one of the signed-in student's assignments to a different status (todo, doing, done).",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "Assignment id from list_assignments."
            },
            "status": {
              "type": "string",
              "enum": [
                "todo",
                "doing",
                "done"
              ],
              "description": "New status."
            }
          },
          "required": [
            "id",
            "status"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_docs",
        "title": "List documents",
        "description": "List the signed-in student's Cogni Docs, most recently updated first.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "limit": {
              "description": "Maximum rows to return (default 25).",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_doc",
        "title": "Read a document",
        "description": "Read the contents of one of the signed-in student's Cogni Docs.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "Document id from list_docs."
            }
          },
          "required": [
            "id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_classes",
        "title": "List classes",
        "description": "List the classes the signed-in student is enrolled in, with teacher, room and period.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      }
    ]
  }
}
